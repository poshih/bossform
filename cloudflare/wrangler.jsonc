{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bossform-relay",
  "main": "src/relay.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RelayRoom"
      }
    ]
  },
  "exports": {
    "RelayRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
